            "doc": "racket-head centre at contact: |x| <= 2.136, -3.68 <= y <= -0.3, 0.2 <= z <= 3.0"
          },
          "normal": {
            "type": "vector",
            "len": 3,
            "nonzero": true,
            "doc": "string-face normal at contact (non-zero)"
          },
          "vel": {
            "type": "vector",
            "len": 3,
            "unit": "m/s",
            "max_norm": 8.0,
            "doc": "racket-head velocity at contact, |vel| <= 8"
          },
          "base": {
            "type": "vector",
            "len": 2,
            "unit": "m",
            "optional": true,
            "doc": "optional: where the base stands at contact (your frame; within the base's range); default the forehand stance for pos (the stance formula); the base stays there after the stroke"
          }
        },
        "feasible": "the platform delivers a request within the tolerances when the contact is at least about 0.9 s ahead from the ready pose, 0.65-1.75 m high, within the base's reach in time and the head speed within about 2.2 t - 0.2 m/s along a forward face; otherwise it does its best and says so (FAILURES).",
        "replaces": "a new act (or none) replaces the stroke under way from its effect step; the swing restarts from the moving arm",
        "notes": {
          "stance": "the base's goal for a contact at pos = (x, y, z) is (x, y) - 0.62 r (1, 1) with r = max(0.30, 0.95 - 0.35 |z - 1.333|) m (a forehand: right of and in front of the base), clipped to the gantry's range; the reply's stroke.base_goal gives it. So a serve whose contact is at that offset from the base's spot keeps the base still (it must stay within 5 cm until the serve is hit)",
          "timing": "The command takes effect when the latency-bench scheduler releases it; t starts at that step.",
          "feedback": "the reply: effect_step and the stroke notes (stroke, base, speed_scale, blade_error_m, normal_error_deg, racket_vel_delivered); state.command: contact_in_s, vel_rehearsed, pos_error_rehearsed_m; last_shots",
          "contact_law": "the shuttle leaves along the face normal at 4 max(0, v_head.n)(1 - 0.3 (r/0.14)^2) + 0.15 max(0, -v_in.n) (spec racket_contact): the player turns the shot it wants into (normal, vel)"
        }
      },
      "toss": {
        "call": "toss(pos, height)",
        "request": {
          "pos": {
            "type": "vector",
            "len": 3,
            "unit": "m",
            "doc": "your serve's toss (docs/conventions/racket_serve_zh.md): the shuttle appears at this point (your frame) when the command takes effect; 0.5 <= z <= 1.8, within 1.0 m (horizontally) of your base, y <= -0.5; only the server, once per serve, from the step the receiver is ready (state.serve)"
          },
          "height": {
            "type": "number",
            "min": 0.0,
            "max": 0.5,
            "unit": "m",
            "optional": true,
            "doc": "how far it rises straight up from pos (0 <= height <= 0.5; default 0: released from rest)"
          }
        },
        "feasible": "every toss within the ranges and the serve's window is executed exactly",
        "replaces": "once per serve",
        "notes": {}
      }
    },
